# Full-test-suite image for mailchat-vault (the Linux column of the
# release validation matrix, scripts/release/matrix-linux.sh).
#
# Ubuntu 24.04 mirrors the CI `test` job's ubuntu-latest runner and the
# e2e job's pinned ubuntu-24.04: same webkit2gtk-4.1/GTK stack the app
# builds against, node 22 copied from the official image, and a rustup
# toolchain WITH rustfmt + clippy (the Dockerfile.build toolchain
# installs the minimal profile, which lacks both — the matrix needs
# them for `cargo fmt --check` and `cargo clippy -D warnings`).
#
# Built by scripts/release/matrix-linux.sh; scripts/release/Dockerfile.e2e
# builds ON TOP of the resulting image tag.
#
#   docker build -t mailchat-vault-suite:24.04 -f Dockerfile.suite .
FROM node:22-bookworm-slim AS node

FROM ubuntu:24.04

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      file \
      git \
      libayatana-appindicator3-dev \
      libgtk-3-dev \
      librsvg2-dev \
      libwebkit2gtk-4.1-dev \
      patchelf \
      pkg-config \
      xz-utils \
    && rm -rf /var/lib/apt/lists/*

# rustup outside /root + world-readable so the image works for any
# runtime uid (matrix containers run as the invoking host user).
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain stable --profile minimal \
          --component rustfmt --component clippy --no-modify-path \
    && chmod -R a+rX /usr/local/rustup /usr/local/cargo \
    && rustc --version && cargo fmt --version && cargo clippy --version

# Writable-by-anyone mount point for the host cargo cache volume
# (shared with the Dockerfile.build toolchain volume, so matrix runs
# reuse the release-build cache).
RUN mkdir -p /cargo && chmod 1777 /cargo

WORKDIR /src
