// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`detail panel > renders meta, full highlighted body and clickable neighbors 1`] = `"<article class="detail-card"><header><h2>ana</h2><button type="button" class="close-btn">✕ Close (Esc)</button></header><dl class="meta-table"><dt>author</dt><dd>ana</dd><dt>sent</dt><dd>2026-01-02T10:00:00Z</dd><dt>source</dt><dd>telegram</dd><dt>channel</dt><dd>chat</dd><dt>chat</dt><dd>devs</dd><dt>external id</dt><dd>e2</dd></dl><ol class="thread" aria-label="Chat thread"><li class="thread-row link" data-id="1" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-01T10:00:00Z</div><div class="body">earlier message about the vault</div></li><li class="thread-row current" data-id="2"><div class="meta">ana · 2026-01-02T10:00:00Z</div><div class="body">The <mark class="hit">Vault</mark> body with <mark class="hit">Vault</mark> twice.</div></li><li class="thread-row link" data-id="3" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-03T10:00:00Z</div><div class="body">later message</div></li></ol><p class="meta">↑/↓ move through the thread · Esc closes</p></article>"`;

exports[`pagination > renders range info and enables the right buttons 1`] = `"<button type="button" class="page-btn">‹ Prev</button><span class="page-info">51–100 of 1234 · page 2/25</span><button type="button" class="page-btn">Next ›</button>"`;

exports[`results list > renders grouped hits with highlighted snippets and active row 1`] = `"<section class="group"><h3>mbox · thread-a (2)</h3><ul class="group-hits"><li class="hit-item" data-index="0" data-id="1"><div class="meta">ana · 2026-01-01T10:00:00Z · email</div><div class="body">pre <mark class="hit">vault</mark> post</div></li><li class="hit-item active" data-index="1" data-id="2" aria-current="true"><div class="meta">ana · 2026-01-02T10:00:00Z · email</div><div class="body"><mark class="hit">vault</mark> only</div></li></ul></section><section class="group"><h3>whatsapp · no thread (1)</h3><ul class="group-hits"><li class="hit-item" data-index="2" data-id="3"><div class="meta">ana · 2026-01-03T10:00:00Z · chat</div><div class="body">browse body</div></li></ul></section>"`;

exports[`source chips > renders toggles with counts and pressed state 1`] = `"<button type="button" class="chip" data-source="mbox" aria-pressed="false">mbox (900)</button><button type="button" class="chip on" data-source="whatsapp" aria-pressed="true">whatsapp (80)</button>"`;
