// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`dashboard > renders summary, day bars, and count tables (snapshot) 1`] = `"<p class="meta">1,234 messages · 2 sources · 2026-01-01 → 2026-03-31</p><div class="day-chart-block"><div class="day-chart" role="group" aria-label="Messages per day"><div class="day-bar" style="height: 50%; --bar-heat: 50;" title="2026-01-01: 10 messages" role="img" aria-label="2026-01-01: 10 messages"><span class="day-bar-count">10</span></div><div class="day-bar" style="height: 100%; --bar-heat: 100;" title="2026-02-01: 20 messages" role="img" aria-label="2026-02-01: 20 messages"><span class="day-bar-count">20</span></div><div class="day-bar" style="height: 25%; --bar-heat: 25;" title="2026-03-31: 5 messages" role="img" aria-label="2026-03-31: 5 messages"><span class="day-bar-count">5</span></div></div><div class="day-chart-axis"><span>2026-01-01</span><span>2026-02-01</span><span>2026-03-31</span></div></div><div class="stat-grid"><div class="stat-table"><h3>By source</h3><table><tbody><tr><td class="label" title="mbox">mbox</td><td class="num">900</td><td class="bar"><div style="width: 100%;"></div></td></tr><tr><td class="label" title="whatsapp">whatsapp</td><td class="num">334</td><td class="bar"><div style="width: 37%;"></div></td></tr></tbody></table></div><div class="stat-table"><h3>Top chats</h3><table><tbody><tr><td class="label" title="whatsapp · family">whatsapp · family</td><td class="num">300</td><td class="bar"><div style="width: 100%;"></div></td></tr><tr><td class="label" title="mbox · thread-a">mbox · Thread-a</td><td class="num">90</td><td class="bar"><div style="width: 30%;"></div></td></tr></tbody></table></div><div class="stat-table"><h3>Top authors</h3><table><tbody><tr><td class="label" title="Ana <ana@example.com>">Ana</td><td class="num">500</td><td class="bar"><div style="width: 100%;"></div></td></tr><tr><td class="label" title="(unknown)">(unknown)</td><td class="num">12</td><td class="bar"><div style="width: 2%;"></div></td></tr></tbody></table></div></div>"`;

exports[`detail panel > renders a solo message with no neighbors (snapshot) 1`] = `"<article class="detail-card"><header><h2>ana</h2><div class="header-actions"><button type="button" class="export-chat-btn" title="Export the whole chat thread of this message"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-export"></use></svg>Export chat…</button><button type="button" class="close-btn"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-close"></use></svg><span>Close</span><kbd>Esc</kbd></button></div></header><dl class="meta-table"><dt>author</dt><dd>ana</dd><dt>sent</dt><dd>2026-01-09T10:00:00Z</dd><dt>source</dt><dd>telegram</dd><dt>channel</dt><dd>chat</dd><dt>chat</dt><dd>devs</dd><dt>external id</dt><dd>e9</dd></dl><ol class="thread" aria-label="Chat thread"><li class="thread-row current" data-id="9"><div class="meta">ana · 2026-01-09T10:00:00Z</div><div class="body">only <mark class="hit">message</mark> in thread</div></li></ol><p class="meta">↑/↓ move through the thread · Esc closes</p></article>"`;

exports[`detail panel > renders media links and unresolved attachment placeholders 1`] = `"<article class="detail-card"><header><h2>ana</h2><div class="header-actions"><button type="button" class="export-chat-btn" title="Export the whole chat thread of this message"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-export"></use></svg>Export chat…</button><button type="button" class="close-btn"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-close"></use></svg><span>Close</span><kbd>Esc</kbd></button></div></header><dl class="meta-table"><dt>author</dt><dd>ana</dd><dt>sent</dt><dd>2026-01-04T10:00:00Z</dd><dt>source</dt><dd>whatsapp</dd><dt>channel</dt><dd>chat</dd><dt>chat</dt><dd>family</dd><dt>external id</dt><dd>e4</dd></dl><section class="detail-media"><h3>media</h3><ul class="media-list"><li class="media-item"><span class="media-kind">image</span><span class="media-name">IMG-20261101-WA0001.jpg</span><span class="meta" title="media/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.jpg">2 KB · media/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.jpg</span></li><li class="media-item"><span class="media-kind">document</span><span class="media-name">plan.pdf</span><span class="meta" title="media/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.pdf">5 MB · media/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.pdf</span></li></ul></section><ol class="thread" aria-label="Chat thread"><li class="thread-row current" data-id="4"><div class="meta">ana · 2026-01-04T10:00:00Z</div><div class="body">IMG-20261101-WA0001.jpg</div></li></ol><p class="meta">↑/↓ move through the thread · Esc closes</p></article>"`;

exports[`detail panel > renders meta, full highlighted body and clickable neighbors 1`] = `"<article class="detail-card"><header><h2>ana</h2><div class="header-actions"><button type="button" class="export-chat-btn" title="Export the whole chat thread of this message"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-export"></use></svg>Export chat…</button><button type="button" class="close-btn"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-close"></use></svg><span>Close</span><kbd>Esc</kbd></button></div></header><dl class="meta-table"><dt>author</dt><dd>ana</dd><dt>sent</dt><dd>2026-01-02T10:00:00Z</dd><dt>source</dt><dd>telegram</dd><dt>channel</dt><dd>chat</dd><dt>chat</dt><dd>devs</dd><dt>external id</dt><dd>e2</dd></dl><ol class="thread" aria-label="Chat thread"><li class="thread-row link" data-id="1" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-01T10:00:00Z</div><div class="body">earlier message about the vault</div></li><li class="thread-row current" data-id="2"><div class="meta">ana · 2026-01-02T10:00:00Z</div><div class="body">The <mark class="hit">Vault</mark> body with <mark class="hit">Vault</mark> twice.</div></li><li class="thread-row link" data-id="3" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-03T10:00:00Z</div><div class="body">later message</div></li></ol><p class="meta">↑/↓ move through the thread · Esc closes</p></article>"`;

