// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`dashboard > renders summary, day bars, and count tables (snapshot) 1`] = `"<p class="meta">1,234 messages · 2 sources · 2026-01-01 → 2026-03-31</p><div class="day-chart-block"><div class="day-chart" role="group" aria-label="Messages per day"><div class="day-bar" style="height: 50%; --bar-heat: 50;" title="2026-01-01: 10 messages" role="img" aria-label="2026-01-01: 10 messages"><span class="day-bar-count">10</span></div><div class="day-bar" style="height: 100%; --bar-heat: 100;" title="2026-02-01: 20 messages" role="img" aria-label="2026-02-01: 20 messages"><span class="day-bar-count">20</span></div><div class="day-bar" style="height: 25%; --bar-heat: 25;" title="2026-03-31: 5 messages" role="img" aria-label="2026-03-31: 5 messages"><span class="day-bar-count">5</span></div></div><div class="day-chart-axis"><span>2026-01-01</span><span>2026-02-01</span><span>2026-03-31</span></div></div><div class="stat-grid"><div class="stat-table"><h3>By source</h3><table><tbody><tr><td class="label" title="mbox">Mail import</td><td class="num">900</td><td class="bar"><div style="width: 100%;"></div></td></tr><tr><td class="label" title="whatsapp">whatsapp</td><td class="num">334</td><td class="bar"><div style="width: 37%;"></div></td></tr></tbody></table></div><div class="stat-table"><h3>Busiest folders</h3><table><tbody><tr><td class="label" title="whatsapp · family">whatsapp · family</td><td class="num">300</td><td class="bar"><div style="width: 100%;"></div></td></tr><tr><td class="label" title="mbox · thread-a">Mail import · Thread-a</td><td class="num">90</td><td class="bar"><div style="width: 30%;"></div></td></tr></tbody></table></div><div class="stat-table"><h3>Top authors</h3><table><tbody><tr><td class="label" title="Ana <ana@example.com>">Ana</td><td class="num">500</td><td class="bar"><div style="width: 100%;"></div></td></tr><tr><td class="label" title="(unknown)">(unknown)</td><td class="num">12</td><td class="bar"><div style="width: 2%;"></div></td></tr></tbody></table></div></div>"`;

exports[`source chips > renders all chips unselected by default (snapshot) 1`] = `"<button type="button" class="chip" data-source="inst-mbox" aria-pressed="false"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-file"></use></svg><span>mbox (900)</span></button><button type="button" class="chip" data-source="inst-telegram" aria-pressed="false"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-chat"></use></svg><span>telegram (80)</span></button>"`;

exports[`source chips > renders toggles with counts and pressed state 1`] = `"<button type="button" class="chip" data-source="inst-mbox" aria-pressed="false"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-file"></use></svg><span>mbox (900)</span></button><button type="button" class="chip on" data-source="inst-whatsapp" aria-pressed="true"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-chat"></use></svg><span>whatsapp (80)</span></button>"`;
