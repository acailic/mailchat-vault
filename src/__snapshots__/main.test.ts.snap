// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`detail view > opens on click, fetches the context with paged cursors, and snapshots the panel 1`] = `"<article class="detail-card"><header><h2 tabindex="-1">ana</h2><div class="header-actions"><button type="button" class="copy-btn" title="Copy the message text with provenance">Copy</button><button type="button" class="copy-link-btn" title="Copy the internal locator (mailchat://message/1)">Copy link</button><button type="button" class="export-selection-btn" title="Export this message as text or JSON">Export…</button><button type="button" class="export-chat-btn" title="Export the whole conversation thread">Export chat…</button><button type="button" class="close-btn">Back to results</button></div></header><dl class="meta-table"><dt>source</dt><dd>mbox</dd><dt>from</dt><dd>ana</dd><dt>conversation</dt><dd title="How the archive knows these messages form one conversation.">thread-a (verified)</dd><dt>date</dt><dd title="Time certainty: assumed — The time was assumed during import and may be off — the source did not state it directly.">2026-01-01T10:00:00Z (assumed)</dd><dt>original timestamp</dt><dd>2026-01-01T10:00:00Z</dd><dt>message id</dt><dd>e1</dd></dl><section class="detail-thread"><h3>Conversation context</h3><div class="row"><button type="button" class="load-earlier-btn" disabled="">Load earlier</button><button type="button" class="load-later-btn" disabled="">Load later</button></div><ol class="thread"><li class="thread-row link" data-id="10" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-01T09:00:00Z</div><div class="body">earlier</div></li><li class="thread-row link" data-id="11" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-01T09:30:00Z</div><div class="body">before current</div></li><li class="thread-row current" data-id="1"><div class="meta">ana · 2026-01-01T10:00:00Z</div><div class="body">quarterly <mark class="hit">vault</mark> report</div></li><li class="thread-row link" data-id="12" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-01T11:00:00Z</div><div class="body">after current</div></li><li class="thread-row link" data-id="13" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-01T12:00:00Z</div><div class="body">much later</div></li></ol></section><details class="detail-provenance"><summary>Provenance</summary><div><ul class="provenance-list"><li>import · item e1 · observed 2026-01-01 00:00:00 · import imp-1</li></ul></div></details><details class="detail-technical"><summary>Technical details</summary><pre class="raw-json">{}</pre></details></article>"`;

exports[`search box > Enter runs a search with the trimmed text and default filters 1`] = `"<li class="hit-item" data-id="1" data-index="0"><input type="checkbox" class="row-select" aria-label="Select message 1 for export"><div class="hit-main" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-01T10:00:00Z (assumed) · mbox · thread-a</div><div class="body">vault …</div></div></li><li class="hit-item" data-id="2" data-index="1"><input type="checkbox" class="row-select" aria-label="Select message 2 for export"><div class="hit-main" role="button" tabindex="0" title="Open this message"><div class="meta">bruno · 2026-01-02T10:00:00Z (assumed) · mbox · thread-a</div><div class="body">vault …</div></div></li><li class="hit-item" data-id="3" data-index="2"><input type="checkbox" class="row-select" aria-label="Select message 3 for export"><div class="hit-main" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-03T10:00:00Z (assumed) · demo</div><div class="body">vault …</div></div></li>"`;
