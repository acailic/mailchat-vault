// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`detail view > opens on click, fetches the context with paged cursors, and snapshots the panel 1`] = `"<article class="detail-card" data-message-id="1"><header><h2 tabindex="-1">ana</h2><div class="header-actions"><button type="button" class="icon-btn copy-btn" aria-label="Copy message" title="Copy the message text with provenance"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-copy"></use></svg></button><button type="button" class="icon-btn copy-link-btn" aria-label="Copy link" title="Copy the internal locator (mailchat://message/1)"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-link"></use></svg></button><details class="reading-export"><summary class="icon-btn" aria-label="Export" title="Export this message or the whole conversation"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-export"></use></svg></summary><div class="export-popover"><div class="export-row"><span class="meta">This message</span><select id="message-format" aria-label="Message export format" title="Message export format"><option value="text">Text</option><option value="json">JSON</option></select><button type="button" class="export-selection-btn" title="Export this message as text or JSON">Export message…</button></div><div class="export-row"><span class="meta">Conversation</span><select id="chat-format" aria-label="Chat export format" title="Chat export format"><option value="csv">CSV</option><option value="json">JSON Lines</option><option value="mbox">MBOX (email rows)</option></select><button type="button" class="export-chat-btn" title="Export the whole conversation thread">Export chat…</button></div></div></details><button type="button" class="icon-btn close-btn" aria-label="Close" title="Close the reading pane (Esc)"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-close"></use></svg></button></div></header><dl class="meta-table"><dt>source</dt><dd>mbox</dd><dt>from</dt><dd>ana</dd><dt>conversation</dt><dd title="How the archive knows these messages form one conversation.">thread-a (verified)</dd><dt>date</dt><dd title="Time certainty: assumed — The time was assumed during import and may be off — the source did not state it directly.">2026-01-01T10:00:00Z (assumed)</dd><dt>original timestamp</dt><dd>2026-01-01T10:00:00Z</dd><dt>message id</dt><dd>e1</dd></dl><section class="detail-thread"><h3>Conversation context</h3><div class="row"><button type="button" class="load-earlier-btn" disabled="">Load earlier</button><button type="button" class="load-later-btn" disabled="">Load later</button></div><ol class="thread"><li class="thread-row link" data-id="10" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-01T09:00:00Z</div><div class="body">earlier</div></li><li class="thread-row link" data-id="11" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-01T09:30:00Z</div><div class="body">before current</div></li><li class="thread-row current" data-id="1"><div class="meta">ana · 2026-01-01T10:00:00Z</div><div class="body">quarterly <mark class="hit">vault</mark> report</div></li><li class="thread-row link" data-id="12" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-01T11:00:00Z</div><div class="body">after current</div></li><li class="thread-row link" data-id="13" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-01T12:00:00Z</div><div class="body">much later</div></li></ol></section><details class="detail-provenance"><summary>Provenance</summary><div><ul class="provenance-list"><li>import · item e1 · observed 2026-01-01 00:00:00 · import imp-1</li></ul></div></details><details class="detail-technical"><summary>Technical details</summary><pre class="raw-json">{}</pre></details></article>"`;

exports[`search box > Enter runs a search with the trimmed text and default filters 1`] = `"<li class="hit-item" data-id="1" data-index="0"><input type="checkbox" class="row-select" aria-label="Select message 1 for export"><div class="hit-main" role="button" tabindex="0" title="Open this message"><div class="meta">ana · <span class="time" title="The time was assumed during import and may be off — the source did not state it directly.">2026-01-01T10:00:00Z (assumed)</span> · mbox · thread-a</div><div class="body">vault …</div></div></li><li class="hit-item" data-id="2" data-index="1"><input type="checkbox" class="row-select" aria-label="Select message 2 for export"><div class="hit-main" role="button" tabindex="0" title="Open this message"><div class="meta">bruno · <span class="time" title="The time was assumed during import and may be off — the source did not state it directly.">2026-01-02T10:00:00Z (assumed)</span> · mbox · thread-a</div><div class="body">vault …</div></div></li><li class="hit-item" data-id="3" data-index="2"><input type="checkbox" class="row-select" aria-label="Select message 3 for export"><div class="hit-main" role="button" tabindex="0" title="Open this message"><div class="meta">ana · <span class="time" title="The time was assumed during import and may be off — the source did not state it directly.">2026-01-03T10:00:00Z (assumed)</span> · demo</div><div class="body">vault …</div></div></li>"`;
