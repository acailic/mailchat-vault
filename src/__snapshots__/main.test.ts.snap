// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`detail view > opens on click, fetches the thread with radius 8, and snapshots the panel 1`] = `"<article class="detail-card"><header><h2 tabindex="-1">ana</h2><div class="header-actions"><button type="button" class="export-chat-btn" title="Export the whole chat thread of this message">⤓ Export chat…</button><button type="button" class="close-btn">✕ Close (Esc)</button></div></header><dl class="meta-table"><dt>author</dt><dd>ana</dd><dt>sent</dt><dd>2026-01-01T10:00:00Z</dd><dt>source</dt><dd>mbox</dd><dt>channel</dt><dd>email</dd><dt>chat</dt><dd>thread-a</dd><dt>external id</dt><dd>e1</dd></dl><ol class="thread" aria-label="Chat thread"><li class="thread-row link" data-id="10" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-10T10:00:00Z</div><div class="body">earlier</div></li><li class="thread-row link" data-id="11" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-11T10:00:00Z</div><div class="body">before current</div></li><li class="thread-row current" data-id="1"><div class="meta">ana · 2026-01-01T10:00:00Z</div><div class="body">quarterly <mark class="hit">vault</mark> report</div></li><li class="thread-row link" data-id="12" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-12T10:00:00Z</div><div class="body">after current</div></li><li class="thread-row link" data-id="13" role="button" tabindex="0" title="Open this message"><div class="meta">ana · 2026-01-13T10:00:00Z</div><div class="body">much later</div></li></ol><p class="meta">↑/↓ move through the thread · Esc closes</p></article>"`;

exports[`search box > Enter runs a search with the trimmed text and default filters 1`] = `"<section class="group"><h3>mbox · thread-a (2)</h3><ul class="group-hits"><li class="hit-item" data-index="0" data-id="1"><div class="meta">ana · 2026-01-01T10:00:00Z · email</div><div class="body">quarterly <mark class="hit">vault</mark> report</div></li><li class="hit-item" data-index="1" data-id="2"><div class="meta">bruno · 2026-01-02T10:00:00Z · email</div><div class="body"><mark class="hit">vault</mark> again</div></li></ul></section><section class="group"><h3>demo · no thread (1)</h3><ul class="group-hits"><li class="hit-item" data-index="2" data-id="3"><div class="meta">ana · 2026-01-03T10:00:00Z · chat</div><div class="body"><mark class="hit">vault</mark> keys</div></li></ul></section>"`;
